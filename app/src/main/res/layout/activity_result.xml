<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="26dp"
    android:paddingHorizontal="56dp"
    android:background="@drawable/background"
    tools:context=".activities.ResultActivity">

    <TextView
        android:id="@+id/resultCategoryTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/retro"
        android:text="CATEGORY"
        android:textAlignment="center"
        android:textColor="@color/dark_blue"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/resultMessageTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="48dp"
        android:text="Well done, NAME!"
        android:textAlignment="center"
        android:textColor="@color/dark_blue"
        android:textSize="36sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/resultCategoryTv" />

    <TextView
        android:id="@+id/resultScoreLabelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your score is:"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/dark_blue"
        app:layout_constraintTop_toBottomOf="@id/resultMessageTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"/>

    <TextView
        android:id="@+id/resultScoreTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 10"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="@color/dark_blue"
        app:layout_constraintTop_toBottomOf="@id/resultScoreLabelTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tryAgainBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="TRY AGAIN"
        android:background="@color/light_green"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/resultScoreTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/backToMenuTv"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/backToMenuTv"
        android:layout_width="0dp"
        android:textAlignment="center"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="16sp"
        android:text="BACK TO MENU"
        android:background="@color/incorrect_answer"
        app:layout_constraintTop_toBottomOf="@id/resultScoreTv"
        app:layout_constraintStart_toEndOf="@+id/tryAgainBtn"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>